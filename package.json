{
  "name": "kanpur-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p api/tsconfig.json && vite build && node scripts/compress-models.mjs dist",
    "preview": "vite preview",
    "map": "python3 tools/osm/convert.py --area moti_jheel",
    "parts": ".venv/bin/python tools/osm/make_parts.py --reuse-counts",
    "part": ".venv/bin/python tools/osm/build_part.py"
  },
  "dependencies": {
    "postgres": "3.4.7",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.18.0",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
