# Copy to .env for development; on Vercel set these in Project → Settings → Environment Variables.

# Postgres (Vercel: add Neon from the Marketplace, it sets DATABASE_URL). Local: sh scripts/devdb.sh
DATABASE_URL=postgres://localhost:5433/kanpur

# signs the login cookies: any long random string (openssl rand -hex 32)
AUTH_SECRET=

# the admin portal's sign-in (admin.html)
ADMIN_USER=admin
ADMIN_PASSWORD=

# email codes through Brevo (brevo.com → SMTP & API → API keys); the sender must be verified in Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ramu

# testing: every email code is this, and no email is sent. Remove it in production.
EMAIL_TEST_CODE=345678

# Google AdSense for the loading page (the admin switches ads on and off)
ADSENSE_CLIENT=
ADSENSE_SLOT=
